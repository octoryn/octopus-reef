{
  "name": "@octopus-reef/ide",
  "displayName": "Reef — governed sessions",
  "version": "0.1.0",
  "description": "The Reef editor surface: run a governed agentic session and watch its tamper-evident evidence chain seal and verify, without leaving the editor.",
  "license": "Apache-2.0",
  "author": "Ran Tao <ran@octopusos.ai>",
  "publisher": "octopus-reef",
  "private": true,
  "type": "module",
  "main": "./dist/extension.cjs",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Themes"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "reef.runSession",
        "title": "Reef: Run Governed Session",
        "category": "Reef"
      },
      {
        "command": "reef.openChat",
        "title": "Reef: Chat",
        "category": "Reef"
      },
      {
        "command": "reef.openWelcome",
        "title": "Reef: Welcome",
        "category": "Reef"
      },
      {
        "command": "reef.openAgentFocus",
        "title": "Reef: Agent Focus",
        "category": "Reef"
      },
      {
        "command": "reef.verifyAgentFocus",
        "title": "Reef: Verify Agent Focus",
        "category": "Reef"
      },
      {
        "command": "reef.verifySession",
        "title": "Reef: Verify",
        "category": "Reef"
      },
      {
        "command": "reef.openPowers",
        "title": "Reef: Powers",
        "category": "Reef"
      },
      {
        "command": "reef.openSpecs",
        "title": "Reef: Specs",
        "category": "Reef"
      },
      {
        "command": "reef.openUsage",
        "title": "Reef: Usage",
        "category": "Reef"
      },
      {
        "command": "reef.openSteering",
        "title": "Reef: Steering",
        "category": "Reef"
      },
      {
        "command": "reef.openHooks",
        "title": "Reef: Hooks",
        "category": "Reef"
      },
      {
        "command": "reef.openBrowser",
        "title": "Reef: Browser",
        "category": "Reef"
      },
      {
        "command": "reef.openBrowserPreview",
        "title": "Reef: Browser Preview",
        "category": "Reef"
      },
      {
        "command": "reef.runBrowserRead",
        "title": "Reef: Run Browser Read",
        "category": "Reef"
      },
      {
        "command": "reef.runBrowserDenial",
        "title": "Reef: Run Browser Denial",
        "category": "Reef"
      },
      {
        "command": "reef.runMcpDemo",
        "title": "Reef: Run MCP Demo",
        "category": "Reef"
      },
      {
        "command": "reef.runMcpDenialDemo",
        "title": "Reef: Run MCP Denial Demo",
        "category": "Reef"
      },
      {
        "command": "reef.checkForUpdates",
        "title": "Reef: Check for Updates",
        "category": "Reef"
      }
    ],
    "themes": [
      {
        "id": "octopus-reef.dark",
        "label": "Reef Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/reef-dark-color-theme.json"
      }
    ],
    "configurationDefaults": {
      "workbench.colorTheme": "octopus-reef.dark"
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "reef",
          "title": "Reef",
          "icon": "$(beaker)"
        }
      ],
      "secondarySidebar": [
        {
          "id": "reef-session-dock",
          "title": "Reef",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "reef-session-dock": [
        {
          "type": "webview",
          "id": "reef.session",
          "name": "Session",
          "icon": "$(comment-discussion)",
          "visibility": "visible"
        }
      ],
      "reef": [
        {
          "type": "webview",
          "id": "reef.powers",
          "name": "Powers",
          "icon": "$(plug)",
          "visibility": "visible"
        },
        {
          "type": "webview",
          "id": "reef.browser",
          "name": "Browser",
          "icon": "$(globe)",
          "visibility": "collapsed"
        },
        {
          "type": "webview",
          "id": "reef.specs",
          "name": "Specs",
          "icon": "$(list-tree)",
          "visibility": "collapsed"
        },
        {
          "type": "webview",
          "id": "reef.steering",
          "name": "Steering",
          "icon": "$(book)",
          "visibility": "collapsed"
        },
        {
          "type": "webview",
          "id": "reef.hooks",
          "name": "Hooks",
          "icon": "$(debug-start)",
          "visibility": "collapsed"
        },
        {
          "type": "webview",
          "id": "reef.usage",
          "name": "Usage",
          "icon": "$(pulse)",
          "visibility": "collapsed"
        }
      ]
    },
    "chatParticipants": [
      {
        "id": "octopus-reef.ide.reef",
        "name": "reef",
        "fullName": "Reef",
        "description": "Run a governed Reef build session with tamper-evident evidence.",
        "sampleRequest": "fix the failing test in this workspace"
      }
    ],
    "configuration": {
      "title": "Reef",
      "properties": {
        "reef.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:4300",
          "description": "URL of the Reef daemon (`reef serve`) when not using the bundled daemon."
        },
        "reef.useBundledServer": {
          "type": "boolean",
          "default": true,
          "description": "Start the bundled local Reef daemon automatically on editor launch."
        },
        "reef.welcome.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the Reef welcome tab on startup when no folder is open."
        },
        "reef.updateRepository": {
          "type": "string",
          "default": "octoryn/octopus-reef-editor",
          "description": "GitHub owner/repository used by Reef: Check for Updates. The command queries GitHub Releases only when run."
        },
        "reef.browser.url": {
          "type": "string",
          "default": "http://127.0.0.1:5173/",
          "description": "Local URL used by Reef browser preview/read commands. Only localhost http/https URLs are accepted."
        },
        "reef.model.provider": {
          "type": "string",
          "enum": [
            "auto",
            "mock",
            "anthropic",
            "bedrock"
          ],
          "default": "auto",
          "description": "Model provider for governed sessions. With no BYOK key, auto falls back to the offline MockDriver."
        },
        "reef.model.apiKey": {
          "type": "string",
          "default": "",
          "description": "Optional BYOK model API key. If empty, Reef reads provider environment variables such as ANTHROPIC_API_KEY."
        },
        "reef.model.name": {
          "type": "string",
          "default": "",
          "description": "Optional model name override for the configured provider."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "reef.verify",
        "title": "Reef: Verify",
        "description": "Open Reef, run the offline demo session, and verify the evidence chain.",
        "steps": [
          {
            "id": "reef.verify.session",
            "title": "Verify a governed session",
            "description": "Reef starts a bundled local daemon, opens the session panel, and runs a keyless offline demo. Run Reef: Verify to re-check the evidence log.",
            "completionEvents": [
              "onCommand:reef.verifySession"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@octopus-reef/protocol": "^0.1.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.24.0"
  }
}
