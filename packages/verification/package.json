{
  "name": "@octopus-reef/verification",
  "version": "0.4.0",
  "description": "Deterministic, durable and tenant-isolated verification control plane for immutable source candidates.",
  "license": "Apache-2.0",
  "author": "Ran Tao <ran@octopusos.ai>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octoryn/octopus-reef.git",
    "directory": "packages/verification"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "reef-verification": "dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./materialization": {
      "types": "./dist/materializer.d.ts",
      "default": "./dist/materializer.js"
    },
    "./adapters/postgres": {
      "types": "./dist/adapters/postgres.d.ts",
      "default": "./dist/adapters/postgres.js"
    },
    "./adapters/local": {
      "types": "./dist/adapters/local.d.ts",
      "default": "./dist/adapters/local.js"
    },
    "./adapters/aws": {
      "types": "./dist/adapters/aws.d.ts",
      "default": "./dist/adapters/aws.js"
    },
    "./adapters/builder-source-bundle-s3": {
      "types": "./dist/adapters/builder-source-bundle-s3.d.ts",
      "default": "./dist/adapters/builder-source-bundle-s3.js"
    },
    "./production": {
      "types": "./dist/production.d.ts",
      "default": "./dist/production.js"
    }
  },
  "files": [
    "dist",
    "migrations",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@octopus-reef/protocol": "^0.1.1",
    "octopus-evidence": "^0.2.0"
  },
  "optionalDependencies": {
    "@aws-sdk/client-ecs": "^3.850.0",
    "@aws-sdk/client-s3": "^3.850.0",
    "@aws-sdk/client-secrets-manager": "^3.850.0",
    "@aws-sdk/client-sqs": "^3.850.0",
    "pg": "^8.16.3"
  },
  "engines": {
    "node": ">=22"
  }
}
