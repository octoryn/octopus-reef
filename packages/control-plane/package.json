{
  "name": "@octopus-reef/control-plane",
  "version": "0.1.1",
  "description": "Deployment-neutral, durable and horizontally scalable execution control plane for the Octopus Reef Agent Kernel.",
  "license": "Apache-2.0",
  "author": "Ran Tao <ran@octopusos.ai>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octoryn/octopus-reef.git",
    "directory": "packages/control-plane"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "reef-control-plane": "dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./adapters/postgres": {
      "types": "./dist/adapters/postgres.d.ts",
      "default": "./dist/adapters/postgres.js"
    },
    "./adapters/aws": {
      "types": "./dist/adapters/aws.d.ts",
      "default": "./dist/adapters/aws.js"
    },
    "./adapters/local": {
      "types": "./dist/adapters/local.d.ts",
      "default": "./dist/adapters/local.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "files": [
    "dist",
    "migrations",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@octopus-reef/adapter-runtime": "^0.1.0",
    "@octopus-reef/agent": "^0.2.1",
    "@octopus-reef/engine": "^0.2.0",
    "@octopus-reef/protocol": "^0.1.0",
    "octopus-evidence": "^0.2.0",
    "octopus-runtime": "^0.7.0",
    "octopus-workstate": "^0.2.0"
  },
  "optionalDependencies": {
    "@aws-sdk/client-ecs": "^3.850.0",
    "@aws-sdk/client-s3": "^3.850.0",
    "@aws-sdk/client-sqs": "^3.850.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@aws-sdk/client-ecs": "^3.850.0",
    "@aws-sdk/client-s3": "^3.850.0",
    "@aws-sdk/client-sqs": "^3.850.0"
  },
  "engines": {
    "node": ">=22"
  }
}
